GEMINI_API_KEY=
# Optional alternatives: groq | ollama
LLM_PROVIDER=gemini
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5435/copilot

# Model turns the agent may spend searching again for weakly covered requirements (0 turns it off)
RESEARCH_ROUNDS=2

# Optional: index the resume from the profile MCP server instead of data/resume/.
# A command that starts it over stdio, or the URL of one served over Streamable HTTP.
# PROFILE_MCP=node ../profile-mcp-server/dist/index.js

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
